# Optional root .env / .env.local; shell overrides both. Safe demo defaults.
ANALYTICS_PROVIDER=mock
# SQLITE_DB_PATH=demo.db
DASHBOARD_DB_PATH=dashboards.db
DASHBOARD_PLANNER=mock
# Set DASHBOARD_PLANNER=structured and configure the endpoint to enable AI.
LLM_BASE_URL=
LLM_MODEL_ID=
# LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
# Optional only for endpoints supporting thinking_budget_tokens:
# LLM_REASONING_BUDGET_TOKENS=1024
# Optional reproducible evaluation; normally unset:
# LLM_SEED=42
LLM_TIMEOUT_MS=120000
LLM_REPAIR_ATTEMPTS=1
LLM_DEBUG_STRUCTURED_OUTPUT=false
PORT=3001
# Bounds unique repository calls per dashboard execution (1..64).
ANALYTICS_EXECUTION_CONCURRENCY=8

# Opt-in read-only Odoo source through an externally managed LOCAL tunnel.
# Only ingestion composition reads these; tests and serving startup do not.
# ODOO_SOURCE_HOST=127.0.0.1
# ODOO_SOURCE_PORT=5432
# ODOO_SOURCE_DATABASE=replace_with_replica_database
# ODOO_SOURCE_USER=replace_with_dedicated_read_only_identity
# ODOO_SOURCE_PASSWORD=replace_outside_source_control
# ODOO_SOURCE_COMPANY_IDS=1
# ODOO_SOURCE_CONNECT_TIMEOUT_MS=5000
# ODOO_SOURCE_STATEMENT_TIMEOUT_MS=15000
# ODOO_SOURCE_BATCH_SIZE=500
# Snapshot lease lifetime: default 120000 ms, maximum 600000 ms.
# ODOO_SOURCE_SNAPSHOT_MAX_DURATION_MS=120000
# Separately owned analytics mart identities; never point these at Odoo.

# Persistent local mart only: PostgreSQL 18.6, 127.0.0.1:55437/el_dabboos_analytics.
# Infrastructure bootstrap credentials are separate from all application identities.
# Set distinct generated secrets of at least 24 characters in ignored .env.local.
# MART_LOCAL_ADMIN_PASSWORD=
# MART_LOCAL_MIGRATOR_PASSWORD=
# MART_LOCAL_INGESTOR_PASSWORD=
# MART_LOCAL_RUNTIME_PASSWORD=
# Connection placeholders only; never commit populated URLs.
# MART_MIGRATOR_URL=postgresql://mart_migrator_login:<password>@127.0.0.1:55437/el_dabboos_analytics
# MART_INGESTOR_URL=postgresql://mart_ingestor_login:<password>@127.0.0.1:55437/el_dabboos_analytics
# MART_RUNTIME_URL=postgresql://mart_runtime_login:<password>@127.0.0.1:55437/el_dabboos_analytics
# MART_POOL_MAX=8
# MART_STATEMENT_TIMEOUT_MS=15000
# MART_MAX_GROUPS=1000
# MART_MAX_DATE_SPAN_DAYS=3660
