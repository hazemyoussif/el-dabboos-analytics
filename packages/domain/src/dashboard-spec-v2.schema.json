{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://el-dabbous.example/schemas/dashboard-spec/v2",
  "title": "DashboardSpec v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "locale",
    "filters",
    "layout",
    "widgets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "locale": {
      "enum": [
        "en",
        "ar"
      ]
    },
    "filters": {
      "$ref": "#/$defs/filters"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns"
      ],
      "properties": {
        "columns": {
          "enum": [
            1,
            2,
            3,
            4
          ]
        }
      }
    },
    "widgets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/widget"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "maxLength": 80
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "ar"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ar": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "values"
      ],
      "properties": {
        "dimension": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dateRange": {
          "$ref": "#/$defs/dateRange"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filter"
          }
        }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "series"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "kpi",
            "line",
            "bar",
            "table"
          ]
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "dimension": {
          "type": "string"
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/series"
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comparison": {
          "enum": [
            "previous_period",
            "month_over_month",
            "year_over_year"
          ]
        },
        "movingAverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "window"
          ],
          "properties": {
            "window": {
              "type": "integer",
              "minimum": 2,
              "maximum": 24
            }
          }
        },
        "runningTotal": {
          "const": true
        },
        "percentageContribution": {
          "const": true
        },
        "ranking": {
          "const": true
        },
        "topN": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direction",
            "limit"
          ],
          "properties": {
            "direction": {
              "enum": [
                "top",
                "bottom"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metric"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "metric": {
          "type": "string"
        },
        "analysis": {
          "$ref": "#/$defs/analysis"
        }
      }
    }
  }
}
