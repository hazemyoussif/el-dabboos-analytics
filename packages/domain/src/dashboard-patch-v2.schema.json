{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://el-dabboos.example/schemas/dashboard-patch/v2",
  "title": "DashboardPatch v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "widget"
            ],
            "properties": {
              "op": {
                "const": "add"
              },
              "widget": {
                "$ref": "#/$defs/widget"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "widgetId"
            ],
            "properties": {
              "op": {
                "const": "remove"
              },
              "widgetId": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "widgetId",
              "widget"
            ],
            "properties": {
              "op": {
                "const": "replace"
              },
              "widgetId": {
                "$ref": "#/$defs/id"
              },
              "widget": {
                "$ref": "#/$defs/widget"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "title"
            ],
            "properties": {
              "op": {
                "const": "set_title"
              },
              "title": {
                "$ref": "#/$defs/text"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "filters"
            ],
            "properties": {
              "op": {
                "const": "set_filters"
              },
              "filters": {
                "$ref": "#/$defs/filters"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "layout"
            ],
            "properties": {
              "op": {
                "const": "set_layout"
              },
              "layout": {
                "$ref": "#/$defs/layout"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "presentation"
            ],
            "properties": {
              "op": {
                "const": "set_presentation"
              },
              "presentation": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/dashboardPresentation"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "maxLength": 80
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "ar"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ar": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "values"
      ],
      "properties": {
        "dimension": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dateRange": {
          "$ref": "#/$defs/dateRange"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filter"
          }
        },
        "datePreset": {
          "enum": [
            "today",
            "yesterday",
            "current_month",
            "previous_month",
            "last_30_days",
            "last_90_days",
            "current_quarter",
            "previous_quarter",
            "current_year",
            "previous_year",
            "last_6_months",
            "last_12_months"
          ]
        }
      },
      "not": {
        "required": [
          "dateRange",
          "datePreset"
        ]
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "series"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "kpi",
            "line",
            "area",
            "bar",
            "pie",
            "treemap",
            "combo",
            "table"
          ]
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "dimension": {
          "type": "string"
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/series"
          }
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comparison": {
          "enum": [
            "previous_period",
            "month_over_month",
            "year_over_year"
          ]
        },
        "movingAverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "window"
          ],
          "properties": {
            "window": {
              "type": "integer",
              "minimum": 2,
              "maximum": 24
            }
          }
        },
        "runningTotal": {
          "const": true
        },
        "percentageContribution": {
          "const": true
        },
        "ranking": {
          "const": true
        },
        "topN": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direction",
            "limit"
          ],
          "properties": {
            "direction": {
              "enum": [
                "top",
                "bottom"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metric"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "metric": {
          "type": "string"
        },
        "analysis": {
          "$ref": "#/$defs/analysis"
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mark": {
              "enum": [
                "bar",
                "line"
              ]
            }
          }
        }
      }
    },
    "gridItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "widgetId",
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "widgetId": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "minW": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "minH": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns"
      ],
      "properties": {
        "columns": {
          "enum": [
            1,
            2,
            3,
            4,
            12
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/gridItem"
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orientation": {
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "pieVariant": {
          "enum": [
            "pie",
            "donut"
          ]
        },
        "legend": {
          "enum": [
            "auto",
            "show",
            "hide"
          ]
        },
        "dataLabels": {
          "enum": [
            "auto",
            "show",
            "hide"
          ]
        },
        "curve": {
          "enum": [
            "straight",
            "smooth"
          ]
        },
        "palette": {
          "enum": [
            "default",
            "blue",
            "green",
            "orange",
            "purple",
            "red",
            "neutral"
          ]
        }
      }
    },
    "dashboardPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {
          "enum": [
            "default",
            "blue",
            "green",
            "orange",
            "purple",
            "red",
            "neutral"
          ]
        }
      }
    }
  }
}
