# Copy outside the build context, protect permissions, and inject through your deployment secret store.
ENVIRONMENT=staging
API_HOST=0.0.0.0
PORT=3001
ACCESS_IDENTITY_MODE=disabled
# After reviewed provisioning/activation: ACCESS_IDENTITY_MODE=local requires HTTPS.
# AUTH_BASE_URL=https://analytics.staging.example.test
# AUTH_SECRET=REPLACE_WITH_INDEPENDENT_SECRET_FROM_SECRET_STORE
CONTROL_PROVIDER=postgres
CONTROL_DATABASE_URL=postgresql://staging_control_app_login:REPLACE@postgres:5432/el_dabboos_control_staging
ANALYTICS_PROVIDER=postgres
MART_RUNTIME_URL=postgresql://staging_mart_runtime_login:REPLACE@postgres:5432/el_dabboos_analytics_staging
CORS_ORIGINS=https://analytics.staging.example.test
DASHBOARD_PLANNER=disabled
# Optional structured planner: DASHBOARD_PLANNER=structured, LLM_BASE_URL, LLM_MODEL_ID, LLM_API_KEY.
# Migrator and administrator secrets never belong in the API runtime environment.
# Serving-only configuration has no source/writer credentials. The explicitly
# approved local manual-operation composition may receive only its scoped secrets.

# Opt-in manual analytics commands. Supply writer and read-only source secrets
# through protected deployment configuration; never copy the operator env wholesale.
ANALYTICS_MANUAL_OPERATIONS=disabled
# Fixed approved local source scope; no request/browser-controlled destination.
# ANALYTICS_SOURCE_TENANT_ID=el-dabboos-iq
# ANALYTICS_SOURCE_ID=el-dabboos-odoo18-pg
# Optional protected Unix socket mounted read-only into the local API container.
# ANALYTICS_SOURCE_RELAY_SOCKET=/run/dabboos-source/source.sock
