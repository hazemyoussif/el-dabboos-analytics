# Root-owned configuration. These are paths and release metadata, not credentials.
# Replace the release placeholder with the deployed 40-character Git commit SHA.
STAGING_API_IMAGE=el-dabboos-api:REPLACE_WITH_DEPLOYED_COMMIT_SHA
STAGING_DATABASE_NETWORK=dabboos-analytics-mart_default
STAGING_OPERATOR_ENV_FILE=/opt/el-dabboos/secrets/staging-operator.env
STAGING_SOURCE_ENV_FILE=/opt/el-dabboos/secrets/odoo-source.env
STAGING_ANALYTICS_TENANT=el-dabboos-iq
