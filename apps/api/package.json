{
  "name": "@el-dabboos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@el-dabboos/application": "workspace:*",
    "@el-dabboos/data": "workspace:*",
    "@el-dabboos/domain": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "better-auth": "1.7.7",
    "fastify": "^5.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --experimental-transform-types --disable-warning=ExperimentalWarning --watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --external:@el-dabboos/* --outfile=dist/server.mjs",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --experimental-transform-types --disable-warning=ExperimentalWarning dist/server.mjs"
  }
}
