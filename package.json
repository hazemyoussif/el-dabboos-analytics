{
  "name": "el-dabboos-analytics",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint packages apps",
    "typecheck": "tsc --noEmit && pnpm --filter @el-dabboos/web exec tsc -p tsconfig.json",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test packages/*/test/*.test.ts apps/*/test/*.test.ts scripts/engineering/test/*.test.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test",
    "seed": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/data/src/seed-cli.ts",
    "build": "pnpm --filter @el-dabboos/api build && pnpm --filter @el-dabboos/web build",
    "dev:api": "pnpm --filter @el-dabboos/api dev",
    "dev:web": "pnpm --filter @el-dabboos/web dev",
    "test:postgres": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test packages/data/test/postgres/*.test.ts",
    "mart:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-transform-types --disable-warning=ExperimentalWarning packages/data/src/postgres/migrate-cli.ts",
    "odoo:pilot": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-transform-types --disable-warning=ExperimentalWarning apps/api/src/odoo-pilot-cli.ts",
    "metadata:migrate": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/data/src/metadata/migrate-cli.ts",
    "metadata:bootstrap": "node --experimental-transform-types --disable-warning=ExperimentalWarning apps/api/src/administration-cli.ts",
    "check:architecture": "node scripts/engineering/check.mjs architecture",
    "check:quality": "node scripts/engineering/check.mjs quality",
    "check:diff": "node scripts/engineering/check.mjs diff",
    "test:guardrails": "node --test scripts/engineering/test/*.test.mjs",
    "mart:local": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-transform-types --disable-warning=ExperimentalWarning apps/api/src/local-mart-cli.ts",
    "control": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-transform-types --disable-warning=ExperimentalWarning apps/api/src/control-cli.ts",
    "staging": "node --experimental-transform-types --disable-warning=ExperimentalWarning apps/api/src/staging-cli.ts",
    "auth:local": "node --experimental-transform-types --disable-warning=ExperimentalWarning apps/api/src/auth/cli.ts",
    "mart:publication": "node --experimental-transform-types --disable-warning=ExperimentalWarning apps/api/src/mart-publication-cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "pnpm@12.6.0"
}
