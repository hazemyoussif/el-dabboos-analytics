{
  "name": "el-dabbous-analytics",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint packages apps",
    "typecheck": "tsc --noEmit && pnpm --filter @el-dabbous/web exec tsc -p tsconfig.json",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test",
    "seed": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/data/src/seed-cli.ts",
    "build": "pnpm --filter @el-dabbous/api build && pnpm --filter @el-dabbous/web build",
    "dev:api": "pnpm --filter @el-dabbous/api dev",
    "dev:web": "pnpm --filter @el-dabbous/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "pnpm@12.6.0"
}
