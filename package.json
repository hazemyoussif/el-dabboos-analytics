{
  "name": "el-dabbous-analytics",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint packages",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test packages/*/test/*.test.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test",
    "seed": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/data/src/seed-cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "pnpm@12.6.0"
}
